{
  "name": "@routeshift/mcp",
  "version": "0.1.0",
  "description": "Read-only Model Context Protocol server exposing the RouteShift model catalog.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "routeshift-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup --clean",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@routeshift/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0",
    "tsup": "^8.5",
    "tsx": "^4.19",
    "vitest": "^3.2.6"
  }
}
