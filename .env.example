# .env.example — RouteShift environment configuration
# Copy to .env and fill in values: cp .env.example .env

# === Proxy Server ===
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prismproxy
CLICKHOUSE_URL=""              # Optional: http://localhost:8123
ADMIN_SECRET=""                # Required for the admin API; generate: openssl rand -hex 32

# === Provider API Keys (at least one required for proxy to route requests) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TOGETHER_API_KEY=""             # Optional
GROQ_API_KEY=""                 # Optional
CLOUDFLARE_ACCOUNT_ID=""        # Required with CLOUDFLARE_WORKERS_AI_TOKEN; 32 lowercase hex
CLOUDFLARE_WORKERS_AI_TOKEN=""  # Optional platform key for Cloudflare GLM-5.3-Flash credits routing
NEURALWATT_API_KEY=""           # Legacy platform key for explicit GLM-5.2 compatibility only

# === Dashboard ===
AUTH_SECRET=""                 # Required: NextAuth JWT signing secret (generate: openssl rand -base64 32)
PROXY_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PROXY_URL=http://localhost:4000
AUTH_URL=http://localhost:3000

# === Security ===
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# 14 MiB accommodates JSON/base64 overhead for PLUGIN_MAX_FILE_BYTES=10 MiB.
MAX_REQUEST_BODY_BYTES=14680064
SEARCH_BACKEND=exa                # Supported: exa (RouteShift-side web context)
EXA_API_KEY=""                     # Required when SEARCH_BACKEND=exa
WEB_SEARCH_SURCHARGE_MICROCENTS=500000 # Billing surcharge is applied by Track D billing
PLUGIN_FETCH_TIMEOUT_MS=5000           # Timeout for backend requests
PLUGIN_MAX_FILE_BYTES=10485760         # Decoded PDF cap (10 MiB); keep body cap >= base64 overhead
PLUGIN_MAX_FILE_PAGES=100               # Reject PDFs above this page count (no silent truncation)
PLUGIN_MAX_EXTRACTED_TEXT_CHARS=1000000 # Reject extraction output above this cap
PLUGIN_MAX_TOTAL_FILE_BYTES=10485760    # Per-request decoded-byte cap across all files
PLUGIN_MAX_TOTAL_EXTRACTED_TEXT_CHARS=1000000 # Per-request extracted-text cap across all files
PLUGIN_MAX_FILES=10                      # Per-request file-count cap
PROVIDER_KEY_SECRET=""          # Required: 64 hex chars for AES-256-GCM encryption of provider keys (generate: openssl rand -hex 32)
PROVIDER_KEY_SECRET_PREVIOUS="" # Optional: prior PROVIDER_KEY_SECRET kept during a key rotation so existing ciphertext still decrypts
EDGE_SHARED_SECRET=""          # Optional but recommended in prod: shared marker that lets the app trust CF-Connecting-IP / edge headers. Unset => edge client-IP headers are NOT trusted (rate-limit edge-trust gate, RSH-56/RSH-66)

# === Provider-key encryption via AWS KMS envelope (optional; RSH-88) ===
# When KMS_KEY_ID is set, provider keys are wrapped with a KMS data key instead
# of the local PROVIDER_KEY_SECRET. Leave KMS_KEY_ID unset to use the local secret.
AWS_REGION=us-east-1           # Default: us-east-1 (only used when KMS_KEY_ID is set)
KMS_KEY_ID=""                   # Optional: AWS KMS key id/ARN for envelope-encrypting provider keys

# === Observability ===
# Sentry error monitoring. NEXT_PUBLIC_SENTRY_DSN enables dashboard browser events;
# SENTRY_DSN enables dashboard server/edge and proxy server events. SENTRY_AUTH_TOKEN
# is only needed during dashboard builds to upload source maps.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID="" # Optional: your own Google Analytics property; unset disables GA
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.05

# Product analytics. These are public browser keys/tokens, but keep real values in
# deployment env vars rather than committed source.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side AI observability for the proxy (optional; disabled when the key is unset).
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Salt for HMAC-SHA256 user pseudonymization (fail-closed: identity omitted if unset).
POSTHOG_IDENTITY_SALT=
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_MIXPANEL_SESSION_REPLAY=false

# === Stripe Billing (Dashboard) ===
STRIPE_SECRET_KEY=""            # Optional: use only your own Stripe test-mode account for local evaluation
STRIPE_WEBHOOK_SECRET=
# Optional metered savings-share price, configured in the operator's Stripe account.
# No Stripe account or payment is required to inspect the app or use a BYOK key.
STRIPE_PRO_METERED_PRICE_ID=
# Legacy plan price IDs are kept here so the webhook can still resolve
# any pre-existing subscriptions in the DB. New checkouts ignore them.
STRIPE_STARTER_PRICE_ID=
STRIPE_STARTER_METERED_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_GROWTH_METERED_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_ENTERPRISE_METERED_PRICE_ID=

# === Stripe Savings Reporting (Proxy) ===
# STRIPE_SECRET_KEY=              # Same key as dashboard — needed for meter reporting
STRIPE_METER_EVENT_NAME=savings_share

# === Prompt Optimizer (Dashboard /optimize) ===
# The optimize feature is visible in the dashboard UI but returns 503 unless
# configured. It calls the provider directly with operator credentials.
OPTIMIZER_PROVIDER=anthropic   # Default: anthropic
OPTIMIZER_ANTHROPIC_KEY=""      # Required for the optimizer when provider=anthropic
OPTIMIZER_MODEL=""              # Optional: override the optimizer model id

# === Yield analytics (Axiom Layer integration, optional) ===
# The yield correlator no-ops (Yield dashboard stays empty) unless both are set.
LAYER_BASE_URL=""               # Optional: Axiom Layer base URL the correlator queries
LAYER_INTERNAL_API_TOKEN=""     # Optional: internal token for the Layer yield API

# === Demo mode (Dashboard) ===
DEMO_MODE_ENABLED=false         # Synthetic demo data is optional; see apps/dashboard scripts
